{
  "name": "analytics-service",
  "version": "1.0.0",
  "description": "Anonymous pageview hit counter, stored in Scaleway S3",
  "type": "module",
  "main": "dist/hit.js",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage",
    "dev": "NODE_ENV=test ANALYTICS_STORAGE=file npx tsx hit.ts",
    "dev:live": "NODE_ENV=test npx tsx hit.ts",
    "dev:stats": "NODE_ENV=test ANALYTICS_STORAGE=file npx tsx stats.ts",
    "dev:stats:live": "NODE_ENV=test npx tsx stats.ts",
    "dev:rollup": "NODE_ENV=test ANALYTICS_STORAGE=file npx tsx rollup.ts",
    "predeploy": "npm run build",
    "deploy": "serverless deploy",
    "info": "serverless info",
    "logs": "serverless logs -f hit",
    "logs:stats": "serverless logs -f stats",
    "logs:rollup": "serverless logs -f rollup",
    "remove": "serverless remove"
  },
  "keywords": [
    "analytics",
    "pageviews",
    "serverless",
    "scaleway"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fretchen/chain-utils": "file:../shared/chain-utils",
    "@fretchen/s3-utils": "file:../shared/s3-utils",
    "viem": "^2.54.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@scaleway/serverless-functions": "^1.1.2",
    "@types/node": "^25.0.10",
    "@vitest/coverage-v8": "^4.0.16",
    "dotenv": "^17.4.2",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "serverless-scaleway-functions": ">=0.4.16",
    "tsup": "^8.3.5",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
