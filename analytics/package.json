{
  "name": "analytics-service",
  "version": "1.0.0",
  "description": "Anonymous pageview hit counter, stored in Scaleway S3",
  "type": "module",
  "main": "dist/analytics.js",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage",
    "dev": "NODE_ENV=test ANALYTICS_STORAGE=file npx tsx analytics.ts",
    "dev:live": "NODE_ENV=test npx tsx analytics.ts",
    "dev:rollup": "NODE_ENV=test ANALYTICS_STORAGE=file npx tsx rollup.ts",
    "deploy": "npm run build && serverless deploy",
    "info": "serverless info",
    "logs": "serverless logs -f analytics",
    "logs:rollup": "serverless logs -f rollup",
    "remove": "serverless remove"
  },
  "keywords": [
    "analytics",
    "pageviews",
    "serverless",
    "scaleway"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fretchen/chain-utils": "file:../shared/chain-utils",
    "@fretchen/s3-utils": "file:../shared/s3-utils",
    "isbot": "^5.2.3",
    "viem": "^2.58.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@scaleway/serverless-functions": "^1.1.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "serverless-scaleway-functions": ">=0.4.16",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
