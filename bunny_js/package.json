{
  "name": "@fretchen/bunny-js",
  "version": "0.1.0",
  "description": "Bunny Edge Script twins of the scw_js x402 sellers. First port: searchapi (web-agent).",
  "type": "module",
  "scripts": {
    "build": "npm run build:searchapi && npm run build:llm && npm run build:mcp",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit && npm run lint && npm run format:check && npm run test",
    "dev": "deno run -A src/index.ts",
    "deploy": "npm run build && bunny scripts deploy dist/searchapi.js",
    "build:searchapi": "tsdown src/searchapi.ts",
    "build:llm": "tsdown src/llm.ts",
    "build:mcp": "tsdown src/mcp.ts"
  },
  "keywords": [
    "bunny.net",
    "edge-scripting",
    "x402"
  ],
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.0.0",
    "prettier": "^3.6.2",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@bunny.net/edgescript-sdk": "^0.11.2",
    "@fretchen/chain-utils": "file:../shared/chain-utils",
    "@fretchen/s3-utils": "file:../shared/s3-utils",
    "@x402/core": "^2.23.0",
    "@x402/evm": "^2.23.0",
    "@x402/extensions": "~2.28.0",
    "viem": "2.57.4",
    "zod": "^4.5.4"
  }
}
