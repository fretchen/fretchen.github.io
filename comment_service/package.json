{
  "name": "comment-service",
  "version": "1.0.0",
  "description": "Blog comment system – anonymous comments stored in Scaleway S3 with email notification",
  "type": "module",
  "main": "dist/comments.js",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage",
    "deploy": "npm run build && serverless deploy",
    "info": "serverless info",
    "logs": "serverless logs -f comments",
    "remove": "serverless remove"
  },
  "keywords": [
    "comments",
    "blog",
    "serverless",
    "scaleway"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fretchen/s3-utils": "file:../shared/s3-utils"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@scaleway/serverless-functions": "^1.1.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-security": "^4.2.1",
    "prettier": "^3.10.1",
    "serverless-scaleway-functions": ">=0.4.16",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
