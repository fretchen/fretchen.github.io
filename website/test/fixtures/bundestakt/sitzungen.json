    {
      "slug": "21-91-2026-09-08",
      "url": "https://www.bundestakt.de/sitzung/21-91-2026-09-08",
      "wahlperiode": 21,
      "sitzungNr": 91,
      "datum": "2026-09-08",
      "dokumentnummer": "21/91",
      "kernthema": "Haushalt 2027: Investitionen, Schulden, Energiepreise",
      "in30Sekunden": [
        {
          "text": "Finanzminister Klingbeil bringt den Haushalt 2027 ein: 555 Milliarden Euro im Kernhaushalt, 118 Milliarden Euro Investitionen – finanziert auch über gut 200 Milliarden Euro neue Kredite.",
          "titel": "204 Milliarden Euro neue Schulden"
        },
        {
          "text": "Steffen Bilger wird als Verkehrsminister vereidigt, Carsten Linnemann als Gesundheitsminister. Der Kabinettsumbau nach der Sommerpause prägt die Debatte über Stil und Führung des Kanzlers.",
          "titel": "Zwei Minister leisten den Amtseid"
        },
        {
          "text": "Die AfD holte 43,8 Prozent, die CDU halbierte sich. Fast jede Rede kreist um die Frage, warum Vertrauen verloren geht – Regierung wie Opposition suchen Erklärungen.",
          "titel": "Sachsen-Anhalt überschattet alles"
        },
        {
          "text": "16 000 Hitzetote, leere Gasspeicher, Rekord-Spritpreise: Koalition verteidigt Klimaziele und Entlastungen, AfD fordert das Ende der Energiewende, Grüne und Linke kritisieren Kürzungen.",
          "titel": "Streit um Energie und Klima"
        },
        {
          "text": "Der Entwurf ist erst überwiesen. Bis zum Herbst verhandeln die Haushälter über Mittelstandsförderung, Schiene, Klimaanpassung – auch Koalitionäre kündigen Nachbesserungen an.",
          "titel": "Jetzt beginnt das Feilschen"
        }
      ],
