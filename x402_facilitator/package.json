{
  "name": "x402-facilitator",
  "version": "1.0.0",
  "description": "Weekly facilitator wallet report (cron). The x402 v2 payment facilitator itself moved to bunny_js/src/facilitator/.",
  "type": "module",
  "main": "dist/wallet_report_cron.js",
  "scripts": {
    "build": "tsdown",
    "predev": "npm run build",
    "dev": "NODE_ENV=test node dist/wallet_report_cron.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage",
    "deploy": "npm run build && serverless deploy",
    "deploy:prod": "npm run build && serverless deploy --stage production",
    "info": "serverless info",
    "logs": "serverless logs -f walletreportcron",
    "remove": "serverless remove"
  },
  "keywords": [
    "x402",
    "payments",
    "optimism",
    "eip712",
    "usdc"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fretchen/chain-utils": "file:../shared/chain-utils",
    "dotenv": "^16.0.0",
    "pino": "^9.0.0",
    "viem": "^2.57.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@scaleway/serverless-functions": "^1.1.2",
    "@types/node": "^25.0.10",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "serverless-scaleway-functions": ">=0.4.16",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*",
    "@rollup/rollup-linux-x64-musl": "*"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "@humanfs/node": "0.16.8"
  },
  "allowScripts": {
    "argon2@0.30.3": true
  }
}
